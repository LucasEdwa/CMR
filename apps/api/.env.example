APP_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# The API connects as app_user (no BYPASSRLS). Migrations run as the owner role.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/crm
DATABASE_OWNER_URL=postgres://crm_owner:crm_owner@localhost:5432/crm
# Only used by `pnpm db:setup` to create the roles and databases locally.
DATABASE_SUPERUSER_URL=postgres://localhost:5432/postgres

RUN_WORKER=true
SENTRY_DSN=

BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=CRM <no-reply@crm.local>
EMAIL_DELIVERY=queue
