{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/server.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrument.js dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/seed.ts",
    "seed:large": "tsx --env-file-if-exists=.env src/seed/seed.ts --large",
    "seed:sample": "tsx --env-file-if-exists=.env src/seed/sample.ts"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@sentry/node": "^11.6.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.1.0",
    "papaparse": "5.7.0",
    "pg-boss": "^12.37.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
